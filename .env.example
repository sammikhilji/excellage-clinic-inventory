# Optional — local Mac/dev: leave both unset to use data/store.json
# Required for Vercel / cloud persistence (Turso free tier):
TURSO_DATABASE_URL=libsql://YOUR-DB-NAME-YOUR-ORG.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# PIN login is disabled. Staff use username + password (see staff handout).
# NEXT_PUBLIC_CLINIC_PIN is ignored when multi-user auth is enabled.
